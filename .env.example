# Copy this file to .env for local use. Never commit the populated file.
# Profiles: local, hosted_demo, production.
MELVAN_DEPLOYMENT_PROFILE=local
MELVAN_ENVIRONMENT=development

# Local relational and attachment storage.
MELVAN_DATABASE=./data/melvan.sqlite3
MELVAN_ATTACHMENT_BACKEND=local
MELVAN_ATTACHMENT_ROOT=./data/attachments

# Model provider. Use demo for a credential-free deterministic installation.
MELVAN_MODEL_MODE=foundry
MELVAN_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
MELVAN_MODEL=your-model-deployment
MELVAN_AUTH_MODE=browser
MELVAN_AUTH_CACHE_NAME=melvan-local-auth
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Hosted deployment values are injected by Azure and Key Vault. Do not place
# production values in this file or commit a populated .env file.
# MELVAN_RESOURCE_GROUP=your-resource-group
# MELVAN_LOCATION=your-azure-region
# MELVAN_APP_NAME=your-melvan-name
# MELVAN_ENVIRONMENT=hosted
# MELVAN_DEPLOYMENT_PROFILE=hosted_demo
# MELVAN_DATABASE=/tmp/melvan/melvan.sqlite3
# MELVAN_PERSISTENT_DATABASE=/var/lib/melvan/melvan.sqlite3
# MELVAN_USERS_FILE=/var/lib/melvan/users.json
# MELVAN_AUTH_MODE=managed_identity
# AZURE_CLIENT_ID=managed-identity-client-id
# MELVAN_AUTH_PEPPER=key-vault-secret-reference
MELVAN_INITIAL_ADMIN_EMAIL=owner@example.org
# MELVAN_EMAIL_MODE=azure
# MELVAN_EMAIL_ENDPOINT=https://your-communication-resource.communication.azure.com
# MELVAN_EMAIL_SENDER=DoNotReply@your-managed-domain.azurecomm.net
# MELVAN_PUBLIC_BASE_URL=https://your-container-app.azurecontainerapps.io

# Production persistence. Prefer managed identity with MELVAN_BLOB_ACCOUNT_URL.
# The connection string is intended only for the local Azurite emulator.
# MELVAN_DEPLOYMENT_PROFILE=production
# MELVAN_DATABASE_URL=postgresql+psycopg://melvan_app:replace-runtime-password@postgres:5432/melvan
# MELVAN_MIGRATION_DATABASE_URL=postgresql+psycopg://melvan_migrator:replace-admin-password@postgres:5432/melvan
# MELVAN_ATTACHMENT_BACKEND=azure_blob
# MELVAN_BLOB_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
# MELVAN_BLOB_CONTAINER=melvan-attachments
# MELVAN_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true

# Explicit deterministic mode for component and interface testing only.
# MELVAN_MODEL_MODE=demo

# Live GPT-5 mini configuration.
# MELVAN_MODEL_MODE=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# MELVAN_MODEL=gpt-5-mini

# Optional credential-refresh command. It is executed without a shell. When it
# prints a raw token or JSON containing access_token, accessToken, or token,
# MELvan uses that value in memory for the current server process.
# MELVAN_AUTH_REFRESH_COMMAND=
